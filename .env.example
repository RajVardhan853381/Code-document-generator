# Environment Configuration
ENVIRONMENT=development

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/code_doc_db
REDIS_URL=redis://localhost:6379/0

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
API_WORKERS=4

# Streamlit Configuration
STREAMLIT_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# LLM Configuration
DEFAULT_LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=30

# Processing Configuration
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_BATCH=100
ENABLE_PARALLEL_PROCESSING=True
MAX_WORKERS=4

# Language Support
SUPPORTED_LANGUAGES=python,javascript,typescript,java,csharp,go,php,ruby,cpp,rust,swift,kotlin

# Documentation Formats
DEFAULT_PYTHON_FORMAT=google
DEFAULT_JS_FORMAT=jsdoc
DEFAULT_JAVA_FORMAT=javadoc

# Storage Configuration
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
TEMP_DIR=./temp

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Security
SECRET_KEY=your_secret_key_here_change_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Monitoring
ENABLE_SENTRY=False
SENTRY_DSN=

# Feature Flags
ENABLE_CROSS_LANGUAGE_ANALYSIS=True
ENABLE_README_GENERATION=True
ENABLE_QUALITY_SCORING=False
